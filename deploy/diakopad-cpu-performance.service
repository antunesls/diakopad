# Pins every CPU core to the "performance" governor on the Raspberry Pi, so
# the clock doesn't ramp down between hits and cause xruns when 16 sfizz_jack
# instances wake up at once. Installed to /etc/systemd/system/ by
# install-ubuntu-studio.sh (pi-headless target only). Check with:
#   cat /sys/devices/system/cpu/cpu0/cpufreq/scaling_governor
[Unit]
Description=DiakoPad: pin the CPU governor to performance

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/bin/sh -c 'for g in /sys/devices/system/cpu/cpu*/cpufreq/scaling_governor; do echo performance > "$g"; done'

[Install]
WantedBy=multi-user.target
