# systemd --user unit for running DiakoPad on a desktop/laptop (Ubuntu
# Studio or similar), as an alternative to deploy/diakopad.service (which is
# a root-owned system unit for the Pi/Zynthian appliance).
#
# Install to ~/.config/systemd/user/diakopad.service (install-ubuntu-studio.sh
# does this for you, substituting __INSTALL_DIR__), then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now diakopad.service
#
# No User= line and no Requires=jack2.service/a2jmidid.service: a --user unit
# already runs as you, matching whatever JACK-compatible server (jackd2 or
# pipewire-jack) is already running in your own session - unlike the Pi,
# where jackd is a root system service and JACK's UID-scoped shared memory
# forces the app to also run as root (see diakopad-runtime.conf). Start your
# audio server yourself first (qjackctl / Ubuntu Studio Controls / PipeWire
# auto-start) - this unit does not manage it.
[Unit]
Description=DiakoPad web app + audio engine orchestrator (pad grid, sound library, sfizz/mod-host)
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__/backend
Environment=DIAKOPAD_SFZ_BANK_DIR=__INSTALL_DIR__/backend/sfz_bank
Environment=DIAKOPAD_MIDI_CHANNEL=10
# sfizz/mod-host binaries and the effect catalog's LV2 URIs/ports - confirm
# on THIS machine with `which sfizz_jack`, `which mod-host` and
# `lv2ls`/`lv2info` (see README.md and backend/engine/effects_catalog.py)
# before relying on the placeholder defaults baked into backend/engine/.
# There is no known-good LV2_PATH/URI set to copy from the Pi deploy - a
# desktop distro's plugin locations and available bundles differ.
Environment=DIAKOPAD_SFIZZ_BIN=sfizz_jack
Environment=DIAKOPAD_MODHOST_BIN=mod-host
Environment=DIAKOPAD_MODHOST_PORT=5555
#Environment=DIAKOPAD_FX_REVERB_LV2_URI=
#Environment=DIAKOPAD_FX_DELAY_LV2_URI=
#Environment=DIAKOPAD_FX_COMPRESSOR_LV2_URI=
#Environment=DIAKOPAD_FX_DRIVE_LV2_URI=
#Environment=DIAKOPAD_FX_EQ3_LV2_URI=
# Master gain is optional but required for master mute/PANIC to cut one-shot
# samples immediately. Confirm its control symbol and range with lv2info.
#Environment=DIAKOPAD_FX_MASTER_GAIN_LV2_URI=
#Environment=DIAKOPAD_FX_MASTER_GAIN_SYMBOL=gain
#Environment=DIAKOPAD_FX_MASTER_GAIN_MIN=-60
#Environment=DIAKOPAD_FX_MASTER_GAIN_MAX=0
ExecStart=__INSTALL_DIR__/backend/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
