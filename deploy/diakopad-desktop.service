# systemd --user unit for running DiakoPad on a desktop/laptop (Ubuntu
# Studio or similar), as an alternative to deploy/diakopad.service (which is
# a root-owned system unit for the Pi/Zynthian appliance).
#
# Install to ~/.config/systemd/user/diakopad.service (install-ubuntu-studio.sh
# does this for you, substituting __INSTALL_DIR__), then:
#   systemctl --user daemon-reload
#   systemctl --user enable --now diakopad.service
#
# No User= line and no Requires=jack2.service/a2jmidid.service: a --user unit
# already runs as you, matching whatever JACK-compatible server (jackd2 or
# pipewire-jack) is already running in your own session - unlike the Pi,
# where jackd is a root system service and JACK's UID-scoped shared memory
# forces the app to also run as root (see diakopad-runtime.conf). Start your
# audio server yourself first (qjackctl / Ubuntu Studio Controls / PipeWire
# auto-start) - this unit does not manage it.
[Unit]
Description=DiakoPad web app + audio engine orchestrator (pad grid, sound library, sfizz/mod-host)
After=graphical-session.target

[Service]
Type=simple
WorkingDirectory=__INSTALL_DIR__/backend
Environment=DIAKOPAD_SFZ_BANK_DIR=__INSTALL_DIR__/backend/sfz_bank
Environment=DIAKOPAD_MIDI_CHANNEL=10
# orchestrator.py's default HARDWARE_MIDI_PATTERN ("system:midi_capture_.*")
# only matches a plain jackd2/a2jmidid setup. Under PipeWire, the SMC-PAD's
# hardware MIDI capture ports show up as "Midi-Bridge:SINCO ..." when wired
# over USB, or "Midi-Bridge:SMC-PAD Bluetooth" when paired over Bluetooth
# (confirm with `jack_lsp -p | grep -i -E "sinco|smc-pad"` on THIS machine) -
# without this override, the physical controller's Note/CC never reaches
# DiakoPad-in and knob-learn/loop recording/controller-action learning
# silently see nothing. Deliberately does NOT also match the raw
# bluez_midi.*/"SMC-PAD:out"/"BLE MIDI 1:out" ports PipeWire exposes
# alongside the Bluetooth one - those look like duplicate representations
# of the same stream, and wiring more than one in would double-trigger pads.
# Quoted (unlike the other Environment= lines here) because systemd splits
# an unquoted Environment= value on whitespace - without the quotes it
# silently truncates this to "...SMC-PAD" at the space before "Bluetooth".
Environment="DIAKOPAD_HARDWARE_MIDI_PATTERN=Midi-Bridge:(SINCO|SMC-PAD Bluetooth).*"
# sfizz/mod-host binaries. The effect catalog's defaults in
# backend/engine/effects_catalog.py are the plugins validated on this very
# target (Ubuntu Studio, set/2026: Dragonfly Hall/Plate, ZamVerb, LSP
# chorus/flanger/phaser, mda delay/compressor/drive, x42 fil4 EQ - install
# script apt-installs them all), so no DIAKOPAD_FX_<NAME>_LV2_URI overrides
# are needed unless your install differs (confirm with lv2ls/lv2info).
Environment=DIAKOPAD_SFIZZ_BIN=sfizz_jack
Environment=DIAKOPAD_MODHOST_BIN=mod-host
Environment=DIAKOPAD_MODHOST_PORT=5555
# Master gain: x42 Stereo Balance as a pure trim (packaged in x42-plugins;
# symbol "trim" in dB, ports in_left/in_right -> out_left/out_right).
# Range -20..0 dB = attenuation only (100% slider = unity), required for
# master mute/PANIC to cut one-shot samples immediately.
Environment=DIAKOPAD_FX_MASTER_GAIN_LV2_URI=http://gareus.org/oss/lv2/balance
Environment=DIAKOPAD_FX_MASTER_GAIN_SYMBOL=trim
Environment=DIAKOPAD_FX_MASTER_GAIN_MIN=-20
Environment=DIAKOPAD_FX_MASTER_GAIN_MAX=0
Environment=DIAKOPAD_FX_MASTER_GAIN_IN_PORTS=in_left,in_right
Environment=DIAKOPAD_FX_MASTER_GAIN_OUT_PORTS=out_left,out_right
ExecStart=__INSTALL_DIR__/backend/.venv/bin/uvicorn app:app --host 0.0.0.0 --port 8080
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
