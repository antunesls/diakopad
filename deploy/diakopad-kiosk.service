[Unit]
Description=DiakoPad Chromium kiosk (separate VT, alongside zynthian-ui)
After=diakopad.service
Requires=diakopad.service

[Service]
Type=simple
User=zynthian
# On this Zynthian install, zynthian-ui's Xorg session owns VT2 (confirmed
# via `cat /sys/class/tty/tty0/active`), not VT1 (that's just a text getty).
# So the kiosk gets its own X server on VT3 instead. VT3 stays inactive (and
# Chromium idle) until vt-toggle switches to it with `chvt 3`.
ExecStart=/usr/bin/xinit /home/zynthian/diakopad/deploy/kiosk-xinitrc -- :1 vt3 -nocursor
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
