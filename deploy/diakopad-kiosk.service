[Unit]
Description=DiakoPad Chromium kiosk
After=diakopad.service
Requires=diakopad.service

[Service]
Type=simple
# Runs as root: opening a virtual console directly failed with "Cannot open
# virtual console 1 (Permission denied)" as User=zynthian, since there's no
# systemd-logind graphical session granting it VT ownership here.
# With zynthian-ui disabled there's no other Xorg session to coexist with,
# so the kiosk just takes over VT1 directly - no VT-switching daemon needed.
ExecStart=/usr/bin/xinit /home/zynthian/diakopad/deploy/kiosk-xinitrc -- :1 vt1 -nocursor
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
