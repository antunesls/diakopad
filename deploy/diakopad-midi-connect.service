[Unit]
Description=Wire DiakoPad's virtual MIDI ports (JACK connections do not persist across reboots)
After=diakopad.service a2jmidid.service jack2.service
Requires=diakopad.service a2jmidid.service jack2.service

[Service]
Type=oneshot
# Runs as root: `jack_lsp`/`jack_connect` as the `zynthian` user could not
# reach the JACK server in testing (missing session env var, most likely
# XDG_RUNTIME_DIR), while root reliably could. This unit only runs a short
# connect command, not a persistent process.
# Both of DiakoPad's virtual ports open eagerly on app startup (see
# backend/app.py's startup hook), so wait for them to show up in `jack_lsp`
# before wiring them.
ExecStartPre=/bin/sh -c 'for i in $(seq 1 60); do jack_lsp 2>/dev/null | grep -q DiakoPad && exit 0; sleep 1; done; echo "DiakoPad MIDI ports never appeared" >&2; exit 1'
# Output -> ZynMidiRouter's dev4_in slot (confirmed free on this device:
# dev0-dev3 were already used by the SMC-PAD/other devices when this was
# set up), so Program Change reaches the Sfizz chain.
ExecStart=/bin/sh -c 'jack_connect "$(jack_lsp | grep "): DiakoPad$")" ZynMidiRouter:dev4_in'
# SMC-PAD hardware -> DiakoPad-in, so knob CCs reach the app for MIDI learn.
# Connects every raw hardware capture port (not just one) since it's unclear
# which exact port carries knob CC vs. pad notes vs. the CubeSuite editor
# protocol; extra connections are harmless, the app only acts on
# control_change messages and ignores everything else.
ExecStart=/bin/sh -c 'for p in $(jack_lsp | grep "^system:midi_capture_"); do jack_connect "$p" "$(jack_lsp | grep "): DiakoPad-in$")"; done'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
