#!/bin/sh
# xinit client script for the DiakoPad kiosk X session (VT3).
xset -dpms
xset s off
# --no-sandbox is required because this runs as root (see diakopad-kiosk.service).
exec chromium \
  --kiosk \
  --no-sandbox \
  --user-data-dir=/root/.config/diakopad-chromium \
  --noerrdialogs \
  --disable-infobars \
  --disable-session-crashed-bubble \
  --check-for-update-interval=31536000 \
  --window-size=1024,600 \
  --window-position=0,0 \
  http://localhost:8080/
